---
import { monthEnd } from "../lib/month";
import { fmtDate } from "../lib/view";
interface Props { month: number }
---
<div class="commit" style="background: #0a0e14">
  <div style="flex: 1 1 360px; min-width: 0">
    <p class="ctitle" style="color: #9198a1; font-weight: 500">ship: not shipped yet</p>
    <p class="cmeta">due {fmtDate(monthEnd(Astro.props.month), { weekday: "long", month: "short", day: "numeric" })}</p>
  </div>
  <div style="display: flex; align-items: center; gap: 8px"><span class="lbl l-ship">ship</span></div>
</div>
