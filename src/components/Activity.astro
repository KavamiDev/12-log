---
import type { Milestone } from "../lib/types";
import { activityLevels } from "../lib/stats";
import { GRID0, GRID_DAYS, dayIndex, monthStart } from "../lib/month";
import { pad, fmtDate } from "../lib/view";

interface Props { milestones: Milestone[]; month: number }
const { milestones, month } = Astro.props;

const DAY = 86_400_000;
const levels = activityLevels(milestones);
const subjects = new Map<number, string[]>();
for (const m of milestones) {
  const d = dayIndex(m.committedAt);
  subjects.set(d, [...(subjects.get(d) ?? []), `${m.type}: ${m.subject}`]);
}
const at = (i: number) => GRID0 + i * DAY + DAY / 2;
// A month name above the column (week) that contains its 1st day.
const columns = Array.from({ length: GRID_DAYS / 7 }, (_, w) => {
  const first = Array.from({ length: 7 }, (_, d) => at(w * 7 + d)).find((t) => fmtDate(t, { day: "numeric" }) === "1");
  return first ? fmtDate(first, { month: "short" }) : "";
});
const days = levels.map((level, i) => ({ level, label: [fmtDate(at(i), { month: "short", day: "numeric" }), ...(subjects.get(i) ?? [])].join(" · ") }));
const inMonth = milestones.filter((m) => m.month === month).length;
const monthName = fmtDate(monthStart(month) + DAY / 2, { month: "long" });
const range = `${fmtDate(monthStart(0) + DAY, { month: "short", year: "numeric" })} to ${fmtDate(monthStart(11) + DAY, { month: "short", year: "numeric" })}`;
---
<section aria-label="Activity over the year" class="box" style="padding: 16px">
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-bottom: 14px">
    <h2 style="margin: 0; font-size: 16px; font-weight: 500">{inMonth} milestone commit{inMonth === 1 ? "" : "s"} in month {pad(month)} · {monthName}</h2>
    <span style="font-size: 12px; color: #9198a1">{range}</span>
  </div>
  <div style="overflow-x: auto; padding-bottom: 4px" tabindex="0" aria-label="Activity grid, scrollable">
    <div style="display: flex; flex-direction: column; gap: 4px; width: max-content">
      <div style="display: flex; gap: 6px">
        <div style="width: 28px"></div>
        <div aria-hidden="true" style={`display: grid; grid-template-columns: repeat(${columns.length}, 11px); gap: 3px; font-size: 11px; color: #9198a1; height: 14px`}>
          {columns.map((m) => <span style="white-space: nowrap; overflow: visible">{m}</span>)}
        </div>
      </div>
      <div style="display: flex; gap: 6px">
        <div aria-hidden="true" style="width: 28px; display: grid; grid-template-rows: repeat(7, 11px); gap: 3px; font-size: 10px; color: #9198a1; line-height: 11px">
          <span>Mon</span><span></span><span>Wed</span><span></span><span>Fri</span><span></span><span></span>
        </div>
        <div style="display: grid; grid-template-rows: repeat(7, 11px); grid-auto-flow: column; grid-auto-columns: 11px; gap: 3px">
          {days.map((d) => <div class={`cell cell-${d.level}`} title={d.label}></div>)}
        </div>
      </div>
    </div>
  </div>
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; margin-top: 12px; font-size: 12px; color: #9198a1">
    <span>One square per day. One month, one product.</span>
    <span style="display: flex; align-items: center; gap: 3px">Less
      {[0, 1, 2, 3, 4].map((l) => <span class={`cell cell-${l}`}></span>)}
      More</span>
  </div>
</section>
